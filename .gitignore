# This workspace contains several unrelated projects. Version only Grove suite files.
/*
!/.gitignore
!/apps/
!/brand/
!/docs/

# Grove App sources only
/apps/*
!/apps/grove/
!/apps/grove/**

# Grove identity assets only (added during Task 1)
/brand/*
!/brand/grove-icon.svg
!/brand/grove-cover.svg

# Keep the approved Grove design and implementation plan; ignore design scratch files.
/docs/*
!/docs/superpowers/
/docs/superpowers/*
!/docs/superpowers/specs/
/docs/superpowers/specs/*
!/docs/superpowers/specs/2026-10-09-grove-suite-design.md
!/docs/superpowers/plans/
/docs/superpowers/plans/*
!/docs/superpowers/plans/2026-10-09-grove-suite.md
!/docs/superpowers/plans/sdk-notes.md

# Generated package artifacts and isolated worktrees are local-only.
/.worktrees/
/worktrees/
/dist-extensions/
